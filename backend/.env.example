DJANGO_SECRET_KEY=change-this
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://contentconsult.in,http://127.0.0.1:8000

# AI providers (server-side keys used by the provider selector; NEVER expose these in frontend code)
# Add the keys you own. Users only see provider names/models and a speed/cost comparison.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite
# For Google Cloud / Vertex AI on Compute Engine, set this to True and use ADC
# from the VM service account instead of storing a Gemini API key.
# GEMINI_USE_VERTEX_AI accepts true/false, 1/0, yes/no, or on/off.
GEMINI_USE_VERTEX_AI=False
GOOGLE_CLOUD_PROJECT=contentconsult
GOOGLE_CLOUD_LOCATION=us-central1
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-haiku-4-5

# Database: SQLite by default. For MySQL set these values.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# SMTP (required for emailing new-user credentials)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Content Consult <your-sending-email@gmail.com>
FRONTEND_LOGIN_URL=http://contentconsult.in/login

# Optional initial accounts
NIFTYBOT_ADMIN_USERNAME=admin
NIFTYBOT_ADMIN_EMAIL=admin@niftysoft.in
NIFTYBOT_ADMIN_PASSWORD=change-me
NIFTYBOT_USER_USERNAME=demo
NIFTYBOT_USER_EMAIL=demo@example.com
NIFTYBOT_USER_PASSWORD=change-me

# Optional AI provider (admin can store/select this from AI & API settings)
XAI_API_KEY=
XAI_MODEL=grok-3-mini
